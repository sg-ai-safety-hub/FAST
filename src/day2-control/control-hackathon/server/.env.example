# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#   cp .env.example .env
# The server reads the app values; the gcloud commands in the README read the
# deploy values. `source .env` before deploying so the commands can substitute them.

# --- App runtime (read by the server: engine.py, app.py) ---

# Required. Your OpenRouter key. Every model call uses it; without it the board
# still serves but all grading errors.
OPENROUTER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required for admin. Guards POST /admin/reset {"token": "..."} — pick a long random
# string. If unset, the reset endpoint is effectively open, so set it.
ADMIN_TOKEN=change-me-to-a-long-random-string

# The shared room key. Gates the writes (submit/dry-run) that spend model calls, so a public URL
# can't burn the OpenRouter budget; the board display stays open. Hand it to participants — they paste
# it into the notebook. If unset, writes are OPEN too — fine for local dev, not for a deployed URL.
ROOM_KEY=change-me-to-the-key-you-share-with-the-room

# Optional model overrides. Defaults live in the TUNABLES block of
# fast/labs/day2_control/control_hackathon.py; uncomment only to override.
# U_MODEL=deepseek/deepseek-chat
# JUDGE_MODEL=qwen/qwen-2.5-72b-instruct

# Optional. Parallel model-call workers (ops knob, not game design). Default 8.
# ARENA_WORKERS=8

# --- Deploy (read by the gcloud commands in README.md, not by the server) ---

# Your GCP project id, the region to deploy into, the Cloud Run service name,
# and the runtime service account the service runs as.
PROJECT=your-gcp-project-id
REGION=europe-west1
SERVICE=control-hackathon
SERVICE_ACCOUNT=control-hackathon@your-gcp-project-id.iam.gserviceaccount.com
